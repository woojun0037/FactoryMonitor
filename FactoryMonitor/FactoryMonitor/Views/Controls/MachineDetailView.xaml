<UserControl x:Class="FactoryMonitor.Views.Controls.MachineDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <GroupBox Header="설비 상세 정보">
        <StackPanel Margin="10">

            <TextBlock Text="설비명"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedMachine.Name}"
                       Margin="0,0,0,10"/>

            <TextBlock Text="상태"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedMachine.Status}"
                       Margin="0,0,0,10"/>

            <TextBlock Text="온도"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedMachine.Temperature, StringFormat={}{0:F1}℃}"
                       Margin="0,0,0,10"/>

            <TextBlock Text="가동률"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedMachine.OperationRate}"
                       Margin="0,0,0,10"/>

            <TextBlock Text="가동시간"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedMachine.RunningTimeText}"
                       Margin="0,0,0,10"/>

            <TextBlock Text="생산량"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedMachine.ProductionCount}"
                       Margin="0,0,0,10"/>

            <TextBlock Text="목표량"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedMachine.TargetCount}"
                       Margin="0,0,0,10"/>

            <TextBlock Text="달성률"
                       FontWeight="Bold"/>
            <TextBlock Text="{Binding SelectedMachine.AchievementRateText}"
                       Margin="0,0,0,20"/>

            <!-- 버튼 영역 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <Button Content="가동"
                        Width="80"
                        Margin="5"
                        Command="{Binding StartCommand}" />

                <Button Content="정지"
                        Width="80"
                        Margin="5"
                        Command="{Binding StopCommand}" />

                <Button Content="오류"
                        Width="80"
                        Margin="5"
                        Command="{Binding ErrorCommand}" />

            </StackPanel>

        </StackPanel>
    </GroupBox>
</UserControl>