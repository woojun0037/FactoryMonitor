<Window x:Class="FactoryMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FactoryMonitor"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="150" />
            <RowDefinition Height="170" />
        </Grid.RowDefinitions>

        <!-- 설비 목록 영역 -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    
                    <TextBlock Width="120" 
                               FontWeight="Bold" 
                               Text="설비명" 
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Width="120" 
                               FontWeight ="Bold" 
                               Text="상태"  
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Width="120" 
                               FontWeight ="Bold" 
                               Text="온도"  
                               HorizontalAlignment="Center"/>
                    
                    <TextBlock Width="120" 
                               FontWeight ="Bold" 
                               Text="가동률"
                               HorizontalAlignment="Center"/>
                    
                </StackPanel>
            </Border>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Machines}"
                     SelectedItem="{Binding SelectedMachine}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="120" 
                                       Text="{Binding Name}"
                                       HorizontalAlignment="Center"/>
                            
                            <TextBlock Width="120"  
                                       Text="{Binding Status}"
                                       Background="{Binding StatusColor}"
                                       HorizontalAlignment="Center"/>
                            
                            <TextBlock Width="120"  
                                       Text="{Binding Temperature, StringFormat={}{0:F4}}"
                                       HorizontalAlignment="Center"/>
                            
                            <TextBlock Width="120"  
                                       Text="{Binding OperationRate}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- 선택된 설비 정보 + 버튼 영역 -->
        <StackPanel Grid.Row="1"
                    Margin="10">
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,5">
                
                <TextBlock Text="선택된 설비 정보"
                           FontWeight="Bold"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,5">
                
                <TextBlock Width="80"
                           FontWeight="Bold"
                           Text="설비명 :" />
                <TextBlock Text="{Binding SelectedMachine.Name}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,5">
                
                <TextBlock Width="80"
                           FontWeight="Bold"
                           Text="상태 :" />
                <TextBlock Text="{Binding SelectedMachine.Status}" 
                           Background="{Binding SelectedMachine.StatusColor}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,5">
                        
                <TextBlock Width="80"
                           FontWeight="Bold"
                           Text="온도 :" />
                <TextBlock Text="{Binding SelectedMachine.Temperature, StringFormat={}{0:F4}}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,5">
                
                <TextBlock Width="80"
                           FontWeight="Bold"
                           Text="가동률 :" />
                <TextBlock Text="{Binding SelectedMachine.OperationRate}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,0">
                <Button Content="시작"
                        Width="80"
                        Margin="0,0,5,0"
                        Command="{Binding StartCommand}"/>

                <Button Content="정지"
                        Width="80"
                        Margin="0,0,5,0"
                        Command="{Binding StopCommand}"/>

                <Button Content="에러"
                        Width="80"
                        Command="{Binding ErrorCommand}"/>
            </StackPanel>
        </StackPanel>

        <!-- 로그 영역 -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Width="80"
                               FontWeight="Bold"
                               Text="시간"/>

                    <TextBlock FontWeight="Bold"
                               Text="메시지"/>
                </StackPanel>
            </Border>

            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Logs}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Width="80"
                                       Text="{Binding TimeText}" />

                            <TextBlock Text="{Binding Message}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>
